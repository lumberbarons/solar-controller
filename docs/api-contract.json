{
  "_comment": [
    "The JSON field names each HTTP endpoint emits, as a sorted list per endpoint.",
    "This file is the contract between the Go handlers and the React frontend, and",
    "it is verified from both sides so a rename cannot slip through to runtime:",
    "",
    "  - internal/app/api_contract_test.go and",
    "    internal/controllers/epever/api_contract_test.go drive the real handlers",
    "    and assert the keys they actually return match the lists below.",
    "  - site/src/api/types.test.ts asserts the field arrays in site/src/api/types.ts",
    "    match the lists below.",
    "",
    "Renaming a field on either side therefore fails CI until this file and the",
    "other side are updated to agree. Keep each list sorted.",
    "",
    "An entry named '<endpoint>#<field>[]' records the fields of the objects",
    "inside a nested array, which a top-level field list would not cover."
  ],
  "endpoints": {
    "GET /api/info": [
      "buildTime",
      "gitCommit",
      "version"
    ],
    "GET /api/epever/metrics": [
      "arrayCurrent",
      "arrayPower",
      "arrayVoltage",
      "batterySoc",
      "batteryTemp",
      "batteryVoltage",
      "chargingCurrent",
      "chargingPower",
      "chargingStatus",
      "collectionTime",
      "deviceTemp",
      "energyGeneratedDaily",
      "timestamp"
    ],
    "GET /api/epever/battery-profile": [
      "batteryCapacity",
      "batteryType",
      "tempCompCoefficient"
    ],
    "GET /api/epever/charging-parameters": [
      "batteryTempLowerLimit",
      "batteryTempUpperLimit",
      "boostDuration",
      "boostReconnectChargingVoltage",
      "boostVoltage",
      "chargingLimitVoltage",
      "controllerTempLowerLimit",
      "controllerTempUpperLimit",
      "dischargingLimitVoltage",
      "equalizationCycle",
      "equalizationDuration",
      "equalizationVoltage",
      "floatVoltage",
      "lowVoltDisconnectVoltage",
      "lowVoltReconnectVoltage",
      "overVoltDisconnectVoltage",
      "overVoltReconnectVoltage",
      "underVoltWarningReconnectVoltage",
      "underVoltWarningVoltage"
    ],
    "GET /api/epever/time": [
      "time"
    ],
    "GET /api/voltgo": [
      "batteries"
    ],
    "GET /api/voltgo#batteries[]": [
      "address",
      "id"
    ],
    "GET /api/voltgo/{id}/metrics": [
      "cellCount",
      "cells",
      "collectionTime",
      "current",
      "soc",
      "soh",
      "temperature",
      "temperatures",
      "timestamp",
      "voltage"
    ],
    "GET /api/voltgo/{id}/metrics#cells[]": [
      "index",
      "voltage"
    ],
    "GET /api/voltgo/{id}/info": [
      "capacityAh",
      "chemistry",
      "deviceStrings",
      "nominalVoltage"
    ]
  }
}
